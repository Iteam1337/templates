{
  "extends": ["config:base"],
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies", "dependencies"],
      "automerge": true
    }
  ]
}
