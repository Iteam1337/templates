{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "rootDir": "./src",
    "outDir": "./build",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"]
}